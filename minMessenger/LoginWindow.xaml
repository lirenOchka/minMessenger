<Window x:Class="minMessenger.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:minMessenger"
        mc:Ignorable="d"
        Title="MinMessenger — Вход"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0E1621">
    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="MinMessenger" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Логин -->
            <TextBlock Text="Логин" Foreground="#8B9AAB" Margin="0,0,0,6"/>
            <TextBox x:Name="LoginBox" 
                     Height="42" 
                     FontSize="15"
                     Padding="12,0"
                     Background="#17212B"
                     Foreground="White"
                     BorderThickness="0"
                     CaretBrush="White"
                     Margin="0,0,0,16"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль" Foreground="#8B9AAB" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" 
                         Height="42" 
                         FontSize="15"
                         Padding="12,0"
                         Background="#17212B"
                         Foreground="White"
                         BorderThickness="0"
                         Margin="0,0,0,16"/>

            <!-- Имя (только при регистрации) -->
            <TextBlock x:Name="NameLabel" Text="Отображаемое имя" Foreground="#8B9AAB" Margin="0,0,0,6" Visibility="Collapsed"/>
            <TextBox x:Name="NameBox" 
                     Height="42" 
                     FontSize="15"
                     Padding="12,0"
                     Background="#17212B"
                     Foreground="White"
                     BorderThickness="0"
                     Margin="0,0,0,20"
                     Visibility="Collapsed"/>

            <!-- Кнопка -->
            <Button x:Name="ActionButton" 
                    Content="Войти" 
                    Height="46" 
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="#2B5278"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ActionButton_Click"/>

            <!-- Переключение -->
            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">
                <Hyperlink x:Name="SwitchLink" Click="SwitchMode_Click" Foreground="#6AB3F3">
                    Нет аккаунта? Зарегистрироваться
                </Hyperlink>
            </TextBlock>

            <!-- Ошибка -->
            <TextBlock x:Name="ErrorText" 
                       Foreground="#FF6B6B" 
                       FontSize="13"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>
