<Window x:Class="minMessenger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:minMessenger"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinWidth="800" MinHeight="450">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== ЛЕВАЯ ПАНЕЛЬ (список чатов) ==================== -->
        <Border Grid.Column="0" Background="#0E1621" BorderBrush="#0A1219" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Шапка -->
                <Border DockPanel.Dock="Top" Background="#17212B" Padding="12" Height="60">
                    <Grid>
                        <TextBlock Text="Чаты" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <Button Content="＋ Группа" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Padding="12,6"
                Background="#2B5278"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="CreateGroup_Click"/>
                    </Grid>
                </Border>

                <!-- Список чатов -->
                <ListBox x:Name="ChatsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ChatsListBox_SelectionChanged">
                         
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2B5278"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E2C3A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- Пример элемента чата (потом будешь биндить) -->
                    <ListBoxItem>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Аватар -->
                            <Ellipse Width="46" Height="46" Fill="#4A90D9"/>

                            <!-- Имя + последнее сообщение -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Иван Петров" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Привет, как дела?" Foreground="#8B9AAB" FontSize="13" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Время -->
                            <TextBlock Grid.Column="2" Text="12:34" Foreground="#6D7F8F" FontSize="12" VerticalAlignment="Top"/>
                        </Grid>
                    </ListBoxItem>

                </ListBox>
            </DockPanel>
        </Border>

        <!-- ==================== ПРАВАЯ ПАНЕЛЬ (чат) ==================== -->
        <Grid Grid.Column="1" Background="#0E1621">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <!-- Шапка чата -->
                <RowDefinition Height="*"/>
                <!-- Сообщения -->
                <RowDefinition Height="Auto"/>
                <!-- Поле ввода -->
            </Grid.RowDefinitions>

            <!-- Шапка чата -->
            <Border Grid.Row="0" Background="#17212B" BorderBrush="#0A1219" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <TextBlock x:Name="ChatTitleText"
                   Text="Выберите чат" 
                   Foreground="White" 
                   FontSize="16" 
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

                    <Button x:Name="AddMemberButton"
                Content="＋ Участник"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Padding="12,6"
                Background="#2B5278"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                Click="AddMember_Click"/>
                </Grid>
            </Border>

            <!-- Область сообщений -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Background="#0E1621"
                          Padding="16">
                <StackPanel x:Name="MessagesPanel">

                </StackPanel>
            </ScrollViewer>

            <!-- Поле ввода + кнопка -->
            <Border Grid.Row="2" Background="#17212B" Padding="12" BorderBrush="#0A1219" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox"
                             Grid.Column="0"
                             Height="42"
                             VerticalContentAlignment="Center"
                             Padding="14,0"
                             FontSize="14"
                             Background="#242F3D"
                             Foreground="White"
                             BorderThickness="0"
                             CaretBrush="White">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="21"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Кнопка отправки -->
                    <Button Click="SendButton_Click"
                            Grid.Column="1" 
                            Width="42" Height="42"
                            Margin="10,0,0,0"
                            Background="#2B5278"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="21">
                                    <TextBlock Text="➤" 
                                               Foreground="White" 
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>